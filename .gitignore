plantillas/*.xlsx
plantillas/*.xls
plantillas/*.xlsb
Plantillas/*.xlsx
Plantillas/*.xls
Plantillas/*.xlsb
# Documento de tesis y el texto extraído de él
bd/Anteproyecto.pdf
bd/_anteproyecto.txt

