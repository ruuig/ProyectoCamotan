# Copie este archivo como .env y complete los valores.
# .env nunca debe subirse al repositorio.

# Base de datos de trabajo
DATABASE_URL="postgresql://usuario:clave@localhost:5432/camotan"

# Base de datos de pruebas. Debe ser distinta de la de trabajo: las pruebas
# crean y borran datos, y suponen la cola de atencion vacia.
DATABASE_URL_TEST="postgresql://usuario:clave@localhost:5432/camotan_test"

# Firma de los JWT. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del servidor (opcional, por omision 3000)
# PORT=3000
